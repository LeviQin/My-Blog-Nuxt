{
  "name": "My-Blog-Nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node node_modules/nuxt/bin/nuxt.mjs dev --port 3006",
    "generate": "node node_modules/nuxt/bin/nuxt.mjs generate",
    "preview": "node node_modules/nuxt/bin/nuxt.mjs preview",
    "typecheck": "node node_modules/nuxt/bin/nuxt.mjs typecheck",
    "check": "npm run typecheck && npm run build",
    "postinstall": "node node_modules/nuxt/bin/nuxt.mjs prepare"
  },
  "dependencies": {
    "@types/markdown-it": "^14.2.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "markdown-it-attrs": "^5.0.1",
    "nuxt": "^4.4.6",
    "pica": "^10.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
